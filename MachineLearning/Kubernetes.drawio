        <mxCell id="QhBe0XQ9GvYatjXHwTlO-20" value="" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry width="800" height="720" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-1" value="" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;" vertex="1" parent="1">
