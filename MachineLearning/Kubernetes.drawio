        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-2" value="" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;" vertex="1" parent="1">
          <mxGeometry x="80" y="44" width="320" height="636" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-3" value="Hallucinations will be eliminated by improving accuracy because a 100 percent accurate model never hallucinates." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="125" y="79" width="235" height="81" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-4" value="Hallucinations are inevitable." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="125" y="200" width="235" height="78" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-5" value="Avoiding hallucinations requires intelligence that only larger models can achieve." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-6" value="Hallucinations are a mysterious glitch in modern&#xa;language models." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="120" y="440" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-7" value="To measure hallucinations, we just need a good&#xa;hallucination eval." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-8" value="Accuracy will not reach 100 percent.&#xa;Some real-world questions are inherently unanswerable, regardless of size, search, or reasoning add-ons." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="485" y="79" width="235" height="81" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-9" value="They are not inevitable.&#xa;Models can abstain when uncertain." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="485" y="200" width="235" height="87" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-10" value="Small models can know their limits.&#xa;Saying I do not know is easier than estimating partial confidence. Calibration is simpler than perfect accuracy." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="485" y="320" width="235" height="90" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-11" value="Hallucinations arise from statistical mechanisms&#xa;and are reinforced by evaluation incentives." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="475" y="440" width="245" height="80" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-12" value="Standalone hallucination evals exist, but have little impact against many accuracy-based evals that penalize uncertainty. Primary metrics must reward expressions of uncertainty." style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;fillStyle=solid;" vertex="1" parent="1">
          <mxGeometry x="480" y="560" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="QhBe0XQ9GvYatjXHwTlO-13" value="" style="curved=1;startArrow=none;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;rounded=0;sketch=1;curveFitting=1;jiggle=2;shadow=0;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;" edge="1" parent="1" source="QhBe0XQ9GvYatjXHwTlO-3" target="QhBe0XQ9GvYatjXHwTlO-8">
