        <mxCell id="GVnak-cB7Vlg1Gr9T-Ec-8" value="**Lifecycle of Hallucination**" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
