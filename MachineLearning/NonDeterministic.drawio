        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-11" value="Introduction&#xa;Problem: LLMs nondeterministic&#xa;Goal: batch-invariant kernels" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="2007" y="20" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-12" value="Floating-Point&#xa;Non-Associativity&#xa;(a+b)+c ≠ a+(b+c)&#xa;Precision &amp; rounding" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1383" y="548" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-13" value="GPU Kernels &amp; Implementation&#xa;Where additions orders come from" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1924" y="196" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-14" value="Atomic Adds&#xa;fetch-and-add&#xa;run-to-run nondeterminism (rare in LLM forward)" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1813" y="372" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-15" value="Batch Invariance (Root Cause)&#xa;Kernel outputs must not depend on batch size/position" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="1866" y="900" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-16" value="Make Kernels Batch-Invariant&#xa;RMSNorm, Matmul, Attention" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1355" y="1286" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-17" value="Implementation&#xa;vLLM + FlexAttention + torch.Library&#xa;repo: batch-invariant-ops" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1355" y="1558" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-18" value="Experiments &amp; Results&#xa;Deterministic completions, Performance, RL" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1025" y="1795" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-19" value="Conclusion &amp; Impact&#xa;Deterministic inference enables reproducibility &amp; true on-policy RL" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="695" y="1995" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-20" value="Many matmul kernels are run-to-run deterministic&#xa;but not batch-invariant" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1721" y="548" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-21" value="RMSNorm&#xa;- Data-parallel reduces per element&#xa;- Small-batch causes split reductions → breaks invariance&#xa;- Options: fixed reduction order or accept perf tradeoff" style="whiteSpace=wrap;strokeWidth=2;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="870" y="1522" width="260" height="198" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-22" value="Matrix Multiplication&#xa;- Tile-based data-parallel&#xa;- Split-K &amp; tensor-core instrs break invariance&#xa;- Option: compile single kernel config → ~20% perf loss" style="whiteSpace=wrap;strokeWidth=2;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="715" y="864" width="260" height="198" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-23" value="Attention&#xa;- Reductions over seq &amp; feature dims&#xa;- KV cache / chunking changes reduction order&#xa;- Use fixed-size Split-KV &amp; consistent KV layout" style="whiteSpace=wrap;strokeWidth=2;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1025" y="876" width="260" height="174" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-24" value="Completions (Qwen3@temp0)&#xa;1000 runs → 80 uniques; divergence at token ~103&#xa;Batch-invariant kernels → 1000 identical completions" style="whiteSpace=wrap;strokeWidth=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;glass=0;" parent="1" vertex="1">
          <mxGeometry x="210" y="1971" width="260" height="198" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-25" value="Performance&#xa;vLLM default: 26s&#xa;Deterministic (unopt): 55s&#xa;+ Improved kernels: 42s&#xa;Acceptable tradeoff" style="whiteSpace=wrap;strokeWidth=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;glass=0;" parent="1" vertex="1">
          <mxGeometry x="55" y="1534" width="260" height="174" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-26" value="True On-Policy RL&#xa;Deterministic inference → sampler==trainer → KL=0&#xa;Stable rewards vs off-policy collapse" style="whiteSpace=wrap;strokeWidth=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;glass=0;" parent="1" vertex="1">
          <mxGeometry x="365" y="1534" width="260" height="174" as="geometry" />
        </mxCell>
        <mxCell id="jfCHmrp5V9K3BisCHLCW-27" value="Practical impact:&#xa;- Reproducible inference&#xa;- Enables true on-policy RL&#xa;- Encourages digging into root causes" style="whiteSpace=wrap;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="695" y="2244" width="260" height="150" as="geometry" />
        </mxCell>
